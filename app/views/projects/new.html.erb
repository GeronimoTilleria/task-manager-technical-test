<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h2 class="h3 card-title mb-4 fw-bold">Nuevo Proyecto</h2>

        <%= form_with(model: @project) do |form| %>
          <% if @project.errors.any? %>
            <div class="alert alert-danger border-0 shadow-sm mb-4">
              <h6 class="alert-heading fw-bold mb-2">
                <%= pluralize(@project.errors.count, "error") %> impidieron guardar este proyecto:
              </h6>
              <ul class="mb-0 ps-3">
                <% @project.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :title, "Título del proyecto", class: "form-label fw-semibold" %>
            <%= form.text_field :title, class: "form-control", placeholder: "Ej. Desarrollo de Sistema ERP" %>
          </div>

          <div class="mb-3">
            <%= form.label :client_id, "Cliente", class: "form-label fw-semibold" %>
            <%= form.collection_select :client_id, Client.all, :id, :name, { prompt: "Selecciona un cliente" }, { class: "form-select" } %>
          </div>

          <div class="mb-4">
            <%= form.label :status, "Estado", class: "form-label fw-semibold" %>
            <%= form.select :status, Project.statuses.keys.map { |status| [status.humanize, status] }, {}, { class: "form-select" } %>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <%= link_to "Volver a la lista", projects_path, class: "btn btn-outline-secondary" %>
            <%= form.submit "Guardar Proyecto", class: "btn btn-primary px-4" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>