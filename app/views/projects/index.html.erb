<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 m-0 text-dark fw-bold">Proyectos</h1>
  <%= link_to new_project_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" do %>
    <i class="bi bi-plus-lg"></i> Nuevo Proyecto
  <% end %>
</div>

<% if @projects.any? %>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Proyecto</th>
            <th>Estado</th>
            <th style="width: 30%;">Progreso</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @projects.each do |project| %>
            <tr>
              <td class="fw-semibold">
                <%= link_to project.title, project_path(project), class: "text-decoration-none text-dark" %>
              </td>
              <td>
                <span class="badge bg-secondary rounded-pill text-uppercase fs-7">
                  <%= project.status %>
                </span>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="progress flex-grow-1" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: <%= project.progress_percentage %>%;" aria-valuenow="<%= project.progress_percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                  </div>
                  <span class="small text-muted fw-bold"><%= project.progress_percentage %>%</span>
                </div>
              </td>
              <td class="text-end">
                <%= link_to "Ver detalle", project_path(project), class: "btn btn-sm btn-outline-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card text-center p-5 border-0 shadow-sm">
    <div class="card-body">
      <h5 class="card-title text-muted">No hay proyectos registrados aún</h5>
      <p class="card-text text-secondary mb-3">Comienza creando tu primer proyecto para gestionar sus tareas.</p>
      <%= link_to "Crear Proyecto", new_project_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>