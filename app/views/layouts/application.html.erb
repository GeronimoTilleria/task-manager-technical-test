<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Project Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Project Manager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Carga la hoja compilada de Bootstrap + estilos personalizados %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <%# Carga los JavaScripts vía Importmap %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <%= render "shared/navbar" %>

    <main class="container my-4">
      <%# Flash Messages dinámicos %>
      <% flash.each do |type, message| %>
        <% bootstrap_class = type == 'notice' ? 'alert-success' : 'alert-danger' %>
        <div class="alert <%= bootstrap_class %> alert-dismissible fade show shadow-sm" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>